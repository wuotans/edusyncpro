{
  "name": "LessonPlan",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string"
    },
    "class_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Lesson plan title"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "objectives": {
      "type": "string",
      "description": "Learning objectives"
    },
    "content": {
      "type": "string",
      "description": "Lesson content"
    },
    "methodology": {
      "type": "string",
      "description": "Teaching methodology"
    },
    "resources": {
      "type": "string",
      "description": "Resources needed"
    },
    "evaluation": {
      "type": "string",
      "description": "Evaluation method"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "school_id",
    "teacher_id",
    "class_id",
    "subject_id",
    "title",
    "date"
  ]
