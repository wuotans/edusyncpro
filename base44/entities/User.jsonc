{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "school_admin",
        "teacher"
      ],
      "default": "teacher"
    },
    "school_id": {
      "type": "string",
      "description": "Reference to School (for school_admin and teacher)"
    }
  }
}