{
  "name": "Student",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "class_id": {
      "type": "string",
      "description": "Reference to SchoolClass"
    },
    "name": {
      "type": "string",
      "description": "Student full name"
    },
    "registration_number": {
      "type": "string",
      "description": "Student registration/enrollment number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "transferred"
      ],
      "default": "active"
    }
  },
  "required": [
    "school_id",
    "class_id",
    "name"
  ]
}